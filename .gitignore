# ============================================================
# Explainable Hybrid Deep Learning IDS — .gitignore
# ============================================================

# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec

# ---------------------------
# Virtual Environments
# ---------------------------
venv/
env/
ENV/
.venv/
.env/
Lib/
Scripts/
Include/

# ---------------------------
# Environment Variables & Secrets
# ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---------------------------
# Dataset CSV Files (large; download separately)
# ---------------------------
dataset/*.csv
dataset/*.zip
dataset/*.tar.gz
dataset/*.parquet
# Keep the README explaining where to get the data
!dataset/README.md
!dataset/NUSW-NB15_features.csv
!dataset/benchmark_sample.csv
!dataset/train_benchmark_sample.csv
!dataset/test_benchmark_sample.csv

# ---------------------------
# Large Result Logs (auto-generated)
# ---------------------------
results/reports/ids_system.log

# ---------------------------
# Training Checkpoints (temporary)
# ---------------------------
artifacts/checkpoints/
*.ckpt
*.h5

# ---------------------------
# IDE & Editor Specific
# ---------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# Jupyter Notebooks
# ---------------------------
.ipynb_checkpoints/
*.ipynb

# ---------------------------
# Testing & Coverage
# ---------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ---------------------------
# Misc Temporary Files
# ---------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/
